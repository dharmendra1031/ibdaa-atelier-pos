@model IbdaaAtelier.Web.Models.Orders.OrderDetailsPage
@using System.Globalization
@{
    ViewData["Title"] = "Order " + Model.Order.OrderId;
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA ATELIER · ORDER</span>
        <h1 class="section-title mt-2 mb-1">@Model.Order.OrderId</h1>
        <p class="text-secondary mb-0">@(ar ? Model.Order.CustomerNameAr : Model.Order.CustomerName) · @Model.Order.CustomerMobile</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Cashier") && Model.Balance > 0 && Model.Order.Status != "Cancelled")
        {
            <a asp-controller="Payments" asp-action="Take" asp-route-id="@Model.Order.OrderId" class="btn btn-primary">
                @(ar ? "تحصيل الباقي" : "Receive Balance")
            </a>
        }
        <a asp-controller="Invoices" asp-action="Index" asp-route-id="@Model.Order.OrderId"
           class="btn btn-outline-primary">
            @(ar ? "عرض الفاتورة" : "View invoice")
        </a>
                <a asp-action="Index" class="btn btn-outline-secondary">@(ar ? "الطلبات" : "Orders")</a>
    </div>
</section>
@if (TempData["Message"] is string message)
{
    <div class="order-feedback" role="status" aria-live="polite">
        <span>@message</span>
        <button type="button" class="btn-close" aria-label="@(ar ? "إغلاق الرسالة" : "Dismiss message")"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="order-feedback order-feedback-error" role="alert" aria-live="assertive">
        <span>@error</span>
        <button type="button" class="btn-close" aria-label="@(ar ? "إغلاق الرسالة" : "Dismiss message")"></button>
    </div>
}
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card filter-card overflow-hidden">
            <div class="card-body p-4">
                <h2 class="h5">@(ar ? "تفاصيل الطلب" : "Order items")</h2>
                <p class="small text-secondary">@(ar ? "الحالة" : "Status"): @Model.Order.Status · @(ar ? "التسليم" : "Delivery"): @Model.Order.DeliveryDate.ToString("dd-MM-yyyy", CultureInfo.InvariantCulture)</p>
                @foreach (var item in Model.Items)
                {
                    <div class="border-top py-3">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <strong>@(ar ? item.NameAr : item.Name)</strong>
                                <small class="d-block text-secondary">@(item.ItemType == "Product" ? item.ProductCode : "Service") · @(item.SizeName ?? "—") · ×@item.Quantity</small>
                            </div>
                            <span class="text-nowrap fw-bold">@item.LineTotal.ToString("0.000", CultureInfo.InvariantCulture) KWD</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <small class="d-block mt-2 text-secondary">@item.Notes</small>
                        }
                        @foreach (var measure in Model.Measurements.Where(m => m.OrderItemId == item.OrderItemId))
                        {
                            <small class="d-block text-secondary">
                                @(ar ? measure.NameAr : measure.Name): @measure.Value.ToString("0.##", CultureInfo.InvariantCulture) @measure.Unit
                            </small>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card filter-card"><div class="card-body p-4">
            <h2 class="h5">@(ar ? "الملخص" : "Balance summary")</h2>
            <dl class="mb-0">
                @if (Model.Order.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between border-bottom py-3">
                        <dt>@(ar ? "المجموع الفرعي" : "Subtotal")</dt>
                        <dd class="mb-0">@Model.Order.Subtotal.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                    </div>
                    <div class="d-flex justify-content-between border-bottom py-3">
                        <dt>@(ar ? "خصم الطلب" : "Order discount")</dt>
                        <dd class="mb-0">-@Model.Order.DiscountAmount.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                    </div>
                }
                <div class="d-flex justify-content-between border-bottom py-3">
                    <dt>@(ar ? "الإجمالي" : "Total")</dt>
                    <dd class="mb-0">@Model.Order.Total.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                </div>
                <div class="d-flex justify-content-between border-bottom py-3">
                    <dt>@(ar ? "الإيصالات" : "Gross received")</dt>
                    <dd class="mb-0">@Model.GrossPaid.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                </div>
                <div class="d-flex justify-content-between border-bottom py-3">
                    <dt>@(ar ? "المسترد" : "Refunded")</dt>
                    <dd class="mb-0">@Model.Refunded.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                </div>
                <div class="d-flex justify-content-between border-bottom py-3">
                    <dt>@(ar ? "الصافي" : "Net paid")</dt>
                    <dd class="mb-0">@Model.Paid.ToString("0.000", CultureInfo.InvariantCulture)</dd>
                </div>
                <div class="d-flex justify-content-between py-3">
                    <dt>@(ar ? "المتبقي" : "Outstanding")</dt>
                    <dd class="mb-0 fw-bold">@Model.Balance.ToString("0.000", CultureInfo.InvariantCulture) KWD</dd>
                </div>
            </dl>
        </div></div>
    </div>
</div>
<section class="card filter-card">
    <div class="card-body p-4">
        <h2 class="h5">@(ar ? "المدفوعات" : "Payment history")</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr>
                    <th scope="col">@(ar ? "التاريخ" : "Date")</th>
                    <th scope="col">@(ar ? "الطريقة" : "Method")</th>
                    <th scope="col">@(ar ? "القيمة" : "Amount")</th>
                    <th scope="col">@(ar ? "النقد المستلم" : "Tendered")</th>
                    <th scope="col">@(ar ? "الباقي" : "Change")</th>
                </tr></thead>
                <tbody>
                @foreach (var receipt in Model.Payments)
                {
                    <tr>
                        <td>@receipt.CreatedAtUtc.ToString("dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                        <td>@receipt.Method</td>
                        <td>@receipt.Amount.ToString("0.000", CultureInfo.InvariantCulture)</td>
                        <td>@receipt.Tendered.ToString("0.000", CultureInfo.InvariantCulture)</td>
                        <td>@receipt.Change.ToString("0.000", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
                @if (Model.Payments.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">@(ar ? "لا توجد مدفوعات بعد." : "No payments recorded.")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (Model.Refunds.Count > 0)
{
    <section class="card filter-card mt-4"><div class="card-body p-4">
        <h2 class="h5">@(ar ? "سجل الاسترداد" : "Refund history")</h2>
        <div class="table-responsive"><table class="table table-sm align-middle">
            <thead><tr>
                <th scope="col">@(ar ? "التاريخ" : "Date")</th>
                <th scope="col">@(ar ? "الطريقة" : "Method")</th>
                <th scope="col">@(ar ? "المبلغ" : "Amount")</th>
                <th scope="col">@(ar ? "السبب" : "Reason")</th>
            </tr></thead>
            <tbody>
            @foreach (var refund in Model.Refunds)
            {
                <tr>
                    <td>@refund.CreatedAtUtc.ToString("dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                    <td>@refund.Method</td>
                    <td>@refund.Amount.ToString("0.000", CultureInfo.InvariantCulture)</td>
                    <td>@refund.Reason</td>
                </tr>
            }
            </tbody>
        </table></div>
    </div></section>
}

@if (User.IsInRole("Admin") && (Model.NextStatuses.Length > 0 || Model.Paid > 0))
{
    <section class="card filter-card mt-4"><div class="card-body p-4">
        <h2 class="h5">@(ar ? "إجراءات المدير" : "Manager actions")</h2>
        @if (Model.Paid > 0)
        {
            <a asp-controller="Refunds" asp-action="Issue" asp-route-id="@Model.Order.OrderId"
               class="btn btn-outline-danger mb-3">@(ar ? "تسجيل رد مبلغ" : "Record a refund")</a>
        }
        @if (Model.NextStatuses.Length > 0)
        {
        <h3 class="h6">@(ar ? "تغيير حالة الطلب" : "Change order status")</h3>
        <p class="small text-secondary">
            @(ar ? "الإلغاء يتطلب سبباً واضحاً واسترداد المبلغ المدفوع بالكامل أولاً." :
                "Cancellation requires a reason and all payments must be refunded first.")
        </p>
        <form id="orderStatusForm" asp-controller="OrderStatus" asp-action="Change" method="post" asp-antiforgery="true"
              class="row g-3 align-items-end">
            <input type="hidden" name="OrderId" value="@Model.Order.OrderId" />
            <div class="col-md-4">
                <label for="nextStatus" class="form-label">@(ar ? "الحالة التالية" : "Next status")</label>
                <select id="nextStatus" name="Status" class="form-select" required>
                    @foreach (var status in Model.NextStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label for="statusRemarks" class="form-label">@(ar ? "ملاحظات" : "Remarks / cancellation reason")</label>
                <input id="statusRemarks" name="Remarks" class="form-control" maxlength="500" />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary">@(ar ? "تحديث" : "Update")</button>
            </div>
        </form>
        }
    </div></section>
}
<section class="card filter-card mt-4"><div class="card-body p-4">
    <h2 class="h5">@(ar ? "سجل الحالات" : "Status history")</h2>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead><tr>
                <th scope="col">@(ar ? "التاريخ" : "Date")</th>
                <th scope="col">@(ar ? "السابق" : "Previous")</th>
                <th scope="col">@(ar ? "الجديد" : "New")</th>
                <th scope="col">@(ar ? "الملاحظات" : "Remarks")</th>
            </tr></thead>
            <tbody>
            @foreach (var step in Model.StatusHistory)
            {
                <tr>
                    <td>@step.ChangedAtUtc.ToString("dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                    <td>@(step.OldStatus ?? "—")</td>
                    <td>@step.NewStatus</td>
                    <td>@(step.Remarks ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div></section>

@section Scripts
{
    <script>
        document.querySelectorAll(".order-feedback .btn-close").forEach(button =>
            button.addEventListener("click", () => { button.parentElement.hidden = true; }));

        const statusForm = document.getElementById("orderStatusForm");
        statusForm?.addEventListener("submit", event => {
            const button = statusForm.querySelector('button[type="submit"]');
            if (button.disabled) { event.preventDefault(); return; }
            if (!statusForm.reportValidity()) { event.preventDefault(); return; }
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            const spinner = document.createElement("span");
            spinner.className = "spinner-border spinner-border-sm me-2";
            spinner.setAttribute("aria-hidden", "true");
            button.replaceChildren(spinner, document.createTextNode(
                document.documentElement.lang === "ar" ? "جار التحديث..." : "Processing..."));
        });
    </script>
}
