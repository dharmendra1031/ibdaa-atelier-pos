@{
    ViewData["Title"] = "Project";
}
<section class="hero">
    <div>
        <p class="eyebrow">IBDAA ATELIER · NEW PROJECT</p>
        <h1>Tailoring shop management and point of sale.</h1>
        <p class="lead">A focused platform for products, measurements, orders and in-store sales. Built separately from the legacy Tailor ERP.</p>
        <a class="primary-link" asp-controller="Catalog" asp-action="Index">Browse product catalogue</a>
    </div>
    <aside class="hero-note">
        <strong>Initial build</strong>
        <p>The catalogue viewer and database foundation are being established. Admin authentication, order entry, payment and website import must be completed before real transactions.</p>
        <span>Do not connect production data yet.</span>
    </aside>
</section>
<section class="features">
    <article><h2>Product catalogue</h2><p>Categories, bilingual names, prices and product galleries.</p></article>
    <article><h2>Measurements</h2><p>Product and category-specific fields with size charts.</p></article>
    <article><h2>Point of sale</h2><p>Customer-first orders, alterations, payments and receipts in the planned next stages.</p></article>
</section>
