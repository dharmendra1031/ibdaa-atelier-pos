@model IbdaaAtelier.Web.Models.Security.UserEditForm
@using System.Globalization
@{
    ViewData["Title"] = "Edit user";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="mb-4">
    <span class="eyebrow">IBDAA ATELIER · ADMIN</span>
    <h1 class="section-title mt-2">@(ar ? "تعديل صلاحيات المستخدم" : "Edit user access")</h1>
    <p class="text-secondary">@ViewBag.UserName</p>
</section>
<div class="card filter-card"><div class="card-body p-4">
    <form method="post" asp-action="Edit" asp-antiforgery="true">
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Role" class="form-label">@(ar ? "الدور" : "Role")</label>
                <select asp-for="Role" class="form-select" required>
                    <option value="Cashier">Cashier</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <label class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <span class="form-check-label">@(ar ? "الحساب نشط" : "Account active")</span>
                </label>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(ar ? "حفظ" : "Save changes")</button>
            <a asp-action="ResetPassword" asp-route-id="@Model.UserId" class="btn btn-outline-primary">@(ar ? "كلمة المرور" : "Reset password")</a>
            <a asp-action="Index" class="btn btn-outline-secondary">@(ar ? "إلغاء" : "Cancel")</a>
        </div>
    </form>
</div></div>
