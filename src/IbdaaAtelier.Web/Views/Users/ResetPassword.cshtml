@model IbdaaAtelier.Web.Models.Security.UserPasswordForm
@using System.Globalization
@{
    ViewData["Title"] = "Reset password";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="mb-4">
    <span class="eyebrow">IBDAA ATELIER · ADMIN</span>
    <h1 class="section-title mt-2">@(ar ? "إعادة تعيين كلمة المرور" : "Reset password")</h1>
    <p class="text-secondary">@ViewBag.UserName</p>
</section>
<div class="card filter-card"><div class="card-body p-4">
    <form method="post" asp-action="ResetPassword" asp-antiforgery="true">
        <input asp-for="UserId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">@(ar ? "كلمة المرور الجديدة" : "New password (12+ characters)")</label>
                <input asp-for="Password" type="password" class="form-control" required minlength="12" maxlength="128" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label">@(ar ? "تأكيد كلمة المرور" : "Confirm password")</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <p class="small text-secondary mt-3">@(ar ? "ستُلغى جميع الجلسات الحالية لهذا المستخدم." :
            "All existing sessions for this account will be invalidated.")</p>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(ar ? "حفظ كلمة المرور" : "Save new password")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@(ar ? "إلغاء" : "Cancel")</a>
        </div>
    </form>
</div></div>
