@using System.Globalization
@{
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var authenticated = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var areaLabel = controller switch
    {
        "Admin" => isArabic ? "لوحة التحكم" : "Dashboard",
        "Pos" => isArabic ? "نقطة البيع" : "POS billing",
        "Orders" or "Payments" or "Refunds" or "OrderStatus" => isArabic ? "الطلبات" : "Orders",
        "Customers" => isArabic ? "العملاء" : "Customers",
        "Categories" => isArabic ? "الفئات" : "Categories",
        "Products" or "ProductImages" or "ProductSetup" => isArabic ? "المنتجات" : "Products",
        "Services" => isArabic ? "خدمات التعديل" : "Alteration services",
        "Users" => isArabic ? "المستخدمون" : "Users",
        "ShopSettings" => isArabic ? "إعدادات المتجر" : "Shop settings",
        _ => isArabic ? "الرئيسية" : "Overview"
    };
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · IBDAA Atelier</title>
    @if (isArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#mainContent">@(isArabic ? "الانتقال إلى المحتوى" : "Skip to content")</a>
    <header class="site-header">
        <div class="container-xxl d-flex align-items-center justify-content-between gap-3">
            <a class="brand d-inline-flex align-items-center gap-2 text-decoration-none"
               asp-controller="Home" asp-action="Index" aria-label="IBDAA Atelier">
                <span class="brand-mark" aria-hidden="true">IA</span>
                <span class="brand-copy">IBDAA <strong>ATELIER</strong><small>@(isArabic ? "إدارة المتجر" : "Shop management")</small></span>
            </a>
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                @if (authenticated)
                {
                    <span class="workspace-user d-none d-sm-inline">@User.Identity?.Name</span>
                }
                <form class="m-0" method="post" asp-controller="Language" asp-action="Set" asp-antiforgery="true">
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button class="btn language-button btn-sm" type="submit" name="culture"
                            value="@(isArabic ? "en-US" : "ar-KW")"
                            aria-label="@(isArabic ? "Switch to English" : "التبديل إلى العربية")">
                        @(isArabic ? "English" : "العربية")
                    </button>
                </form>
                @if (authenticated)
                {
                    <form class="m-0" method="post" asp-controller="Auth" asp-action="Logout" asp-antiforgery="true">
                        <button class="btn btn-outline-secondary btn-sm" type="submit">@(isArabic ? "خروج" : "Sign out")</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Login">@(isArabic ? "دخول" : "Sign in")</a>
                }
            </div>
        </div>
    </header>
    @if (authenticated)
    {
        <div class="container-xxl app-layout">
            <aside class="app-sidebar" aria-label="@(isArabic ? "تنقل المتجر" : "Shop navigation")">
                <partial name="_Navigation" />
            </aside>
            <div class="app-workspace">
                <details class="mobile-menu mb-3">
                    <summary>@(isArabic ? "القائمة والأقسام" : "Menu & sections")</summary>
                    <partial name="_Navigation" />
                </details>
                <nav aria-label="Breadcrumb" class="workspace-breadcrumb mb-3">
                    <span>IBDAA ATELIER</span><span aria-hidden="true">/</span><span aria-current="page">@areaLabel</span>
                </nav>
                <main id="mainContent" class="page-shell">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main id="mainContent" class="page-shell container-xxl">
            @RenderBody()
        </main>
    }
    <footer class="site-footer">
        <div class="container-xxl d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>© @DateTime.UtcNow.Year IBDAA Atelier</span>
            <span>@(isArabic ? "الدينار الكويتي · العربية / الإنجليزية" : "KWD · English / Arabic")</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
