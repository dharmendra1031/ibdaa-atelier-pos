@model ProductGalleryPage
@using System.Globalization
@{
    ViewData["Title"] = "Product gallery";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA · PRODUCT GALLERY</span>
        <h1 class="section-title mt-2 mb-1">@(ar ? "صور المنتج" : "Product photographs")</h1>
        <p class="text-secondary mb-0">@Model.Product.Name · @Model.Product.ProductCode</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Product.ProductId">
        @(ar ? "العودة للمنتج" : "Back to product")
    </a>
</section>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<section class="card filter-card mb-4">
    <div class="card-body p-4">
        <h2 class="h5">@(ar ? "إضافة صورة جديدة" : "Upload a photograph")</h2>
        <p class="text-secondary small">
            @(ar ? "يدعم أربع صور أو أكثر لكل منتج. الحد الأقصى 5 ميغابايت للصورة. JPEG وPNG وWebP فقط." :
                "Four or more photographs are supported. Maximum 5 MB each; JPEG, PNG or WebP only.")
        </p>
        <form asp-action="Upload" asp-controller="ProductImages" method="post"
              enctype="multipart/form-data" asp-antiforgery="true" class="row g-3 align-items-end">
            <input type="hidden" name="productId" value="@Model.Product.ProductId" />
            <div class="col-md-8">
                <label for="newProductImage" class="form-label">@(ar ? "اختر صورة" : "Choose image")</label>
                <input id="newProductImage" class="form-control image-upload-input" name="file"
                       type="file" accept="image/jpeg,image/png,image/webp" required />
                <img class="image-preview rounded-3 mt-2" hidden alt="@(ar ? "معاينة" : "Upload preview")" />
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-primary">@(ar ? "رفع الصورة" : "Upload photo")</button>
            </div>
        </form>
    </div>
</section>

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h5 mb-0">@(ar ? "معرض الصور" : "Image gallery")</h2>
    <span class="text-secondary small">@Model.Images.Count @(ar ? "صور" : "photos")</span>
</div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
    @foreach (var image in Model.Images)
    {
        <div class="col">
            <article class="card filter-card h-100 overflow-hidden">
                <img class="gallery-photo" src="@image.ImagePath" loading="lazy" decoding="async"
                     width="360" height="420" alt="@Model.Product.Name" />
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <span class="small text-secondary">#@image.ProductImageId</span>
                        @if (image.IsPrimary)
                        {
                            <span class="badge text-bg-success">@(ar ? "الرئيسية" : "Primary")</span>
                        }
                    </div>
                    @if (!image.IsPrimary)
                    {
                        <form asp-action="MakePrimary" method="post" asp-antiforgery="true" class="mb-2">
                            <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                            <input type="hidden" name="imageId" value="@image.ProductImageId" />
                            <button type="submit" class="btn btn-outline-primary btn-sm w-100">@(ar ? "تعيين رئيسية" : "Set as primary")</button>
                        </form>
                    }
                    <form asp-action="Replace" method="post" asp-antiforgery="true"
                          enctype="multipart/form-data" class="mb-2">
                        <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                        <input type="hidden" name="imageId" value="@image.ProductImageId" />
                        <label for="replacement_@image.ProductImageId" class="form-label small">
                            @(ar ? "استبدال الصورة" : "Replace photograph")
                        </label>
                        <input id="replacement_@image.ProductImageId" name="file" type="file" required
                               class="form-control form-control-sm image-upload-input mb-2"
                               accept="image/jpeg,image/png,image/webp" />
                        <img class="image-preview rounded-3 mb-2" hidden alt="@(ar ? "معاينة" : "Replacement preview")" />
                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">@(ar ? "استبدال" : "Replace")</button>
                    </form>
                    <form asp-action="Delete" method="post" asp-antiforgery="true">
                        <input type="hidden" name="productId" value="@Model.Product.ProductId" />
                        <input type="hidden" name="imageId" value="@image.ProductImageId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            @(ar ? "حذف الصورة" : "Remove")
                        </button>
                    </form>
                </div>
            </article>
        </div>
    }
</div>
@if (Model.Images.Count == 0)
{
    <div class="card filter-card">
        <div class="card-body text-secondary text-center py-5">
            @(ar ? "لم تتم إضافة صور لهذا المنتج بعد." : "No photographs yet. Upload a front-view image to start.")
        </div>
    </div>
}
@section Scripts
{
    <script src="~/js/product-gallery.js" asp-append-version="true" defer></script>
}
