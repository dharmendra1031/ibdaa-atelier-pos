@model CatalogPage
@using System.Globalization
@{
    ViewData["Title"] = "Catalogue";
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">@(isArabic ? "مجموعة المنتجات" : "THE COLLECTION")</span>
        <h1 class="section-title mt-2 mb-2">@(isArabic ? "كتالوج المنتجات" : "Product catalogue")</h1>
        <p class="text-secondary mb-0">@(isArabic ? "عرض المنتجات المتاحة فقط. البيع وتعديل المنتجات غير متاحين بعد." : "Browse active products. Editing and checkout are not enabled yet.")</p>
    </div>
    <span class="result-count">@(isArabic ? "المنتجات المعروضة" : "Products shown"): @Model.Products.Count</span>
</section>

<form method="get" asp-action="Index" asp-controller="Catalog" class="card filter-card mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="categoryId" class="form-label">@(isArabic ? "الفئة" : "Category")</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">@(isArabic ? "جميع الفئات" : "All categories")</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId" selected="@(Model.SelectedCategoryId == category.CategoryId)">
                            @(isArabic ? category.NameAr ?? category.Name : category.Name)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="search" class="form-label">@(isArabic ? "البحث عن منتج" : "Search products")</label>
                <input id="search" class="form-control" type="search" name="search" value="@Model.Search" maxlength="100" placeholder="@(isArabic ? "الاسم أو رمز المنتج" : "Name, Arabic name or SKU")" />
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" type="submit">@(isArabic ? "بحث" : "Search")</button>
            </div>
        </div>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <section class="empty-state card border-0 text-center py-5">
        <div class="card-body py-4">
            <div class="empty-symbol" aria-hidden="true">IA</div>
            <h2 class="h4 mt-3">@(isArabic ? "لا توجد منتجات للعرض" : "No products to display")</h2>
            <p class="text-secondary mx-auto mb-0 empty-text">
                @(isArabic
                    ? "لا توجد منتجات مطابقة أو لم يتم استيراد الكتالوج بعد. لن نضيف منتجات أو أسعاراً تجريبية."
                    : "No products match your search, or the catalogue has not been imported. No sample products or prices have been fabricated.")
            </p>
        </div>
    </section>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <article class="card product-card h-100">
                    <div class="product-media">
                        @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" width="360" height="450" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="product-placeholder" aria-label="@(isArabic ? "بدون صورة" : "No image")">IA</span>
                        }
                    </div>
                    <div class="card-body p-3 p-md-4 d-flex flex-column">
                        <span class="product-sku">@product.ProductCode</span>
                        <h2 class="h6 product-title mt-2 mb-1">@(isArabic ? product.NameAr ?? product.Name : product.Name)</h2>
                        @if (!string.IsNullOrWhiteSpace(product.NameAr) && !isArabic)
                        {
                            <p class="product-arabic mb-2" dir="rtl" lang="ar">@product.NameAr</p>
                        }
                        <div class="product-pricing d-flex align-items-baseline flex-wrap gap-2 mt-auto pt-3">
                            <strong>@product.Price.ToString("0.000", CultureInfo.InvariantCulture) <small>KWD</small></strong>
                            @if (product.RegularPrice is decimal regular)
                            {
                                <s>@regular.ToString("0.000", CultureInfo.InvariantCulture)</s>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
