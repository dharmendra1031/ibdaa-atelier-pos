@using System.Globalization
@{
    ViewData["Title"] = "Catalogue setup";
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="empty-state card border-0 text-center py-5 my-4">
    <div class="card-body py-4">
        <div class="empty-symbol" aria-hidden="true">IA</div>
        <h1 class="h3 mt-3">@(isArabic ? "قاعدة بيانات المنتجات غير مهيأة" : "Catalogue database is not configured")</h1>
        <p class="text-secondary mx-auto empty-text">
            @(isArabic
                ? "اضبط اتصال قاعدة بيانات الاختبار وطبّق مخطط المنتجات بعد مراجعته. لا يتم تشغيل ترحيلات تلقائية."
                : "Configure AtelierDb locally and apply the reviewed catalogue schema to an approved test database. No database migrations run automatically.")
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">@(isArabic ? "العودة للرئيسية" : "Return to overview")</a>
    </div>
</section>
