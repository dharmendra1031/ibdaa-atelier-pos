@model IbdaaAtelier.Web.Models.Orders.PosPage
@using System.Globalization
@{
    ViewData["Title"] = "New order";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<section class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA ATELIER · POS</span>
        <h1 class="section-title mt-2 mb-1">@(ar ? "طلب جديد" : "New tailoring order")</h1>
        <p class="text-secondary mb-0">@(ar ? "اختر العميل أولاً، ثم أضف المنتجات أو الخدمات." : "Select a customer first, then add products or alteration services.")</p>
    </div>
    <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-primary">@(ar ? "عميل جديد" : "Add customer")</a>
</section>
<div class="pos-shell row g-4" id="posShell"
     data-product-url="@Url.Action("Product", "Pos")"
     data-customer-url="@Url.Action("FindCustomers", "Pos")"
     data-reserve-url="@Url.Action("Reserve", "Pos")"
     data-save-url="@Url.Action("Save", "Pos")"
     data-order-url="@Url.Action("Details", "Orders")"
     data-arabic="@(ar ? "true" : "false")">
    <div class="col-lg-7">
        <div class="d-flex gap-2 mb-3" role="group" aria-label="@(ar ? "نوع العنصر" : "Catalogue type")">
            <button type="button" class="btn btn-primary flex-fill" id="showProducts" aria-controls="catalogueProducts" aria-pressed="true">@(ar ? "المنتجات" : "Products")</button>
            <button type="button" class="btn btn-outline-primary flex-fill" id="showServices" aria-controls="catalogueServices" aria-pressed="false">@(ar ? "خدمات التعديل" : "Alterations")</button>
        </div>
        <div id="catalogueProducts">
        <section class="card filter-card mb-4">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-3">@(ar ? "كتالوج المنتجات" : "Product catalogue")</h2>
                <form method="get" asp-action="Index" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label for="catalogCategory" class="form-label">@(ar ? "الفئة" : "Category")</label>
                        <select id="catalogCategory" name="categoryId" class="form-select">
                            <option value="">@(ar ? "كل الفئات" : "All categories")</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(category.CategoryId == Model.CategoryId)">@(ar ? category.NameAr ?? category.Name : category.Name)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label for="catalogSearch" class="form-label">@(ar ? "بحث" : "Search")</label>
                        <input id="catalogSearch" type="search" class="form-control" name="search" maxlength="100" value="@Model.Search" placeholder="@(ar ? "اسم المنتج أو الرمز" : "Product name or code")" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">@(ar ? "بحث" : "Search")</button>
                    </div>
                </form>
            </div>
        </section>
        <div class="row row-cols-2 row-cols-md-3 g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <button type="button" class="card product-card pos-product h-100 w-100 text-start"
                            data-product-id="@product.ProductId" aria-label="@(ar ? product.NameAr ?? product.Name : product.Name)">
                        <span class="product-media">
                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath" width="360" height="450" loading="lazy" decoding="async" alt="@product.Name" />
                            }
                            else
                            {
                                <span class="product-placeholder" aria-hidden="true">IA</span>
                            }
                        </span>
                        <span class="card-body p-3 d-flex flex-column w-100">
                            <small class="product-sku">@product.ProductCode</small>
                            <strong class="product-title mt-2">@(ar ? product.NameAr ?? product.Name : product.Name)</strong>
                            <small class="mt-auto pt-2 product-pricing">@product.Price.ToString("0.000", CultureInfo.InvariantCulture) KWD</small>
                        </span>
                    </button>
                </div>
            }
        </div>
        @if (Model.Products.Count == 0)
        {
            <p class="text-secondary text-center py-4">@(ar ? "لا توجد منتجات مطابقة." : "No matching products.")</p>
        }
        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex align-items-center justify-content-between mt-3" aria-label="Product pages">
                <span class="small text-secondary">@Model.Page / @Model.TotalPages</span>
                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@(ar ? "السابق" : "Previous")</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@(ar ? "التالي" : "Next")</a>
                    }
                </div>
            </nav>
        }
        </div>
        <section id="catalogueServices" class="mt-3" hidden>
            <h2 class="h5 mb-3">@(ar ? "خدمات التعديل" : "Alteration services")</h2>
            <div class="row row-cols-1 row-cols-sm-2 g-2">
                @foreach (var service in Model.Services)
                {
                    <div class="col">
                        <button type="button" class="btn btn-outline-primary w-100 text-start pos-service"
                                data-service-id="@service.ServiceId"
                                data-name="@service.Name" data-name-ar="@service.NameAr"
                                data-price="@service.Price.ToString("0.000", CultureInfo.InvariantCulture)">
                            <span class="d-flex justify-content-between align-items-center gap-2">
                                <span>@(ar ? service.NameAr : service.Name)</span>
                                <strong class="text-nowrap">@service.Price.ToString("0.000", CultureInfo.InvariantCulture)</strong>
                            </span>
                        </button>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        <section class="card filter-card pos-checkout">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-3">@(ar ? "الطلب الحالي" : "Current order")</h2>
                <p class="small text-secondary mb-3">@(ar ? "١. العميل ← ٢. العناصر ← ٣. الحفظ والدفع" : "1. Customer → 2. Cart → 3. Save & payment")</p>
                <form id="posCheckoutForm" asp-controller="Pos" asp-action="Save" method="post" asp-antiforgery="true">
                    <label for="customerSearch" class="form-label">@(ar ? "ابحث عن العميل" : "Find customer") *</label>
                    <input id="customerSearch" class="form-control" type="search" autocomplete="off"
                           placeholder="@(ar ? "الاسم أو رقم الهاتف" : "Name or mobile number")" />
                    <div id="customerResults" class="list-group mt-2" role="listbox" aria-label="@(ar ? "نتائج العملاء" : "Matching customers")"></div>
                    <div id="selectedCustomer" class="small text-secondary mt-2" role="status">@(ar ? "لم يتم اختيار عميل" : "No customer selected")</div>
                    <div class="mt-3">
                        <label for="deliveryDate" class="form-label">@(ar ? "تاريخ التسليم" : "Delivery date") *</label>
                        <input id="deliveryDate" type="date" value="@today" min="@today" class="form-control" required />
                    </div>
                    <hr />
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <h3 class="h6 mb-0">@(ar ? "العناصر" : "Items")</h3>
                        <span id="cartCount" class="small text-secondary">0</span>
                    </div>
                    <div id="orderCart" class="pos-cart" aria-live="polite">
                        <p class="text-secondary small">@(ar ? "لا توجد عناصر بعد." : "No items added yet.")</p>
                    </div>
                    <hr />
                    <div class="d-flex align-items-baseline justify-content-between gap-2">
                        <span>@(ar ? "المجموع" : "Total")</span>
                        <strong id="cartTotal" class="h4 mb-0">0.000 KWD</strong>
                    </div>
                    <p class="small text-secondary mt-2">@(ar ? "يُحسب السعر النهائي في الخادم. سيتم حفظ الطلب دون دفع." : "Prices are checked when saving. To take full, advance or split payment, open the saved order.")</p>
                    <div id="posMessage" class="small mb-3" role="status" aria-live="polite"></div>
                    <button type="submit" id="saveOrderButton" class="btn btn-primary w-100">@(ar ? "حفظ طلب غير مدفوع" : "Save unpaid order")</button>
                    <a id="savedOrderLink" class="btn btn-outline-primary w-100 mt-2" hidden>
                        @(ar ? "عرض الطلب واستلام الدفعة" : "View order / receive payment")
                    </a>
                    <button type="button" id="newOrderButton" class="btn btn-outline-secondary w-100 mt-2" hidden>@(ar ? "طلب جديد" : "Start another order")</button>
                </form>
            </div>
        </section>
    </div>
</div>
<dialog id="productDialog" class="pos-dialog" aria-labelledby="dialogTitle">
    <form method="dialog" class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <h2 id="dialogTitle" class="h5 mb-0"></h2>
        <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Close">×</button>
    </form>
    <div id="dialogFields"></div>
    <div class="d-flex gap-2 mt-4">
        <button type="button" id="addProductButton" class="btn btn-primary">@(ar ? "إضافة للطلب" : "Add to order")</button>
        <button type="button" id="cancelProductButton" class="btn btn-outline-secondary">@(ar ? "إلغاء" : "Cancel")</button>
    </div>
</dialog>

@section Scripts
{
    <script src="~/js/pos.js" asp-append-version="true" defer></script>
}
