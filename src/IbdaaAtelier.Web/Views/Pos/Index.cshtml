@model IbdaaAtelier.Web.Models.Orders.PosPage
@using System.Globalization
@{
    ViewData["Title"] = "New order";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<section class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3 pos-heading">
    <div>
        <span class="eyebrow">IBDAA ATELIER · POS</span>
        <h1 class="section-title mt-2 mb-1">@(ar ? "نقطة البيع" : "POS Billing")</h1>
        <p class="text-secondary mb-0">@(ar ? "المنتجات · التعديلات · الخياطة" : "Garments · Alterations · Tailoring")</p>
    </div>
    <nav class="d-flex flex-wrap gap-2 pos-shortcuts" aria-label="@(ar ? "روابط سريعة" : "Quick links")">
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary">@(ar ? "الطلبات" : "Orders")</a>
        <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-primary">@(ar ? "العملاء" : "Customers")</a>
        <a asp-controller="Register" asp-action="Index" class="btn btn-outline-primary">@(ar ? "الصندوق" : "Register")</a>
    </nav>
</section>
<div class="pos-shell row g-4" id="posShell"
     data-product-url="@Url.Action("Product", "Pos")"
     data-customer-url="@Url.Action("FindCustomers", "Pos")"
     data-customer-create-url="@Url.Action("QuickCreate", "Customers")"
     data-invoice-url="@Url.Action("FindInvoice", "Pos")"
     data-payment-prepare-url="@Url.Action("Prepare", "Payments")"
     data-payment-record-url="@Url.Action("Record", "Payments")"
     data-print-url="@Url.Action("Print", "Invoices")"
     data-reserve-url="@Url.Action("Reserve", "Pos")"
     data-save-url="@Url.Action("Save", "Pos")"
     data-arabic="@(ar ? "true" : "false")"
     data-discount-enabled="@(Model.EnablePosDiscount ? "true" : "false")"
     data-show-services="@(Model.ShowServices ? "true" : "false")">
    <div class="col-lg-7">
        <div class="d-flex gap-2 mb-2 pos-catalogue-switch" role="group" aria-label="@(ar ? "نوع العنصر" : "Catalogue type")">
            <button type="button" class="btn btn-primary flex-fill" id="showProducts" aria-controls="catalogueProducts" aria-pressed="true">@(ar ? "المنتجات" : "Products")</button>
            <button type="button" class="btn btn-outline-primary flex-fill" id="showServices" aria-controls="catalogueServices" aria-pressed="false">@(ar ? "خدمات التعديل" : "Alterations")</button>
        </div>
        <div id="catalogueProducts">
            <section class="pos-catalogue-tools mb-3">
                <form method="get" asp-action="Index" class="d-flex gap-2 mb-3" role="search">
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                    <label class="visually-hidden" for="catalogSearch">@(ar ? "بحث عن منتج" : "Search products")</label>
                    <span class="pos-search-icon" aria-hidden="true">⌕</span>
                    <input id="catalogSearch" type="search" class="form-control" name="search" maxlength="100"
                           value="@Model.Search" placeholder="@(ar ? "اسم المنتج أو الرمز" : "Find products by name or code")" />
                    <button type="submit" class="btn btn-primary">@(ar ? "بحث" : "Search")</button>
                </form>
                <nav class="pos-categories d-flex gap-2" aria-label="@(ar ? "فئات المنتجات" : "Product categories")">
                    <a asp-action="Index" asp-route-search="@Model.Search"
                       class="pos-category @(Model.CategoryId == null ? "active" : "")"
                       aria-current="@(Model.CategoryId == null ? "page" : null)">@(ar ? "الكل" : "All")</a>
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@category.CategoryId" asp-route-search="@Model.Search"
                           class="pos-category @(Model.CategoryId == category.CategoryId ? "active" : "")"
                           aria-current="@(Model.CategoryId == category.CategoryId ? "page" : null)">
                            @(ar ? category.NameAr ?? category.Name : category.Name)
                        </a>
                    }
                </nav>
            </section>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xxl-4 g-2 g-md-3 pos-product-grid">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <button type="button" class="card product-card pos-product h-100 w-100 text-start"
                            data-product-id="@product.ProductId" aria-label="@(ar ? product.NameAr ?? product.Name : product.Name)">
                        <span class="product-media">
                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath" width="360" height="450" loading="lazy" decoding="async" alt="@product.Name" />
                            }
                            else
                            {
                                <span class="pos-missing-photo" aria-hidden="true"><span class="pos-photo-outline"></span><span>@(ar ? "لا توجد صورة" : "No photo yet")</span></span>
                            }
                        </span>
                        <span class="card-body p-3 d-flex flex-column w-100">
                            <small class="product-sku">@product.ProductCode</small>
                            <strong class="product-title mt-2">@(ar ? product.NameAr ?? product.Name : product.Name)</strong>
                            <small class="mt-auto pt-2 product-pricing">@product.Price.ToString("0.000", CultureInfo.InvariantCulture) KWD</small>
                        </span>
                    </button>
                </div>
            }
        </div>
        @if (Model.Products.Count == 0)
        {
            <p class="text-secondary text-center py-4">@(ar ? "لا توجد منتجات مطابقة." : "No matching products.")</p>
        }
        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex align-items-center justify-content-between mt-3" aria-label="Product pages">
                <span class="small text-secondary">@Model.Page / @Model.TotalPages</span>
                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@(ar ? "السابق" : "Previous")</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">@(ar ? "التالي" : "Next")</a>
                    }
                </div>
            </nav>
        }
        </div>
        <section id="catalogueServices" class="pos-service-layout" hidden>
            <nav class="pos-service-categories" aria-label="@(ar ? "فئات الخدمات" : "Alteration categories")">
                <a asp-action="Index" asp-route-services="true" asp-route-serviceSearch="@Model.ServiceSearch"
                   class="pos-category @(Model.ServiceCategoryId == null ? "active" : "")">@(ar ? "كل الخدمات" : "All Services")</a>
                @foreach (var category in Model.ServiceCategories)
                {
                    <a asp-action="Index" asp-route-services="true" asp-route-serviceCategoryId="@category.ServiceCategoryId"
                       asp-route-serviceSearch="@Model.ServiceSearch"
                       class="pos-category @(Model.ServiceCategoryId == category.ServiceCategoryId ? "active" : "")">@(ar ? category.NameAr : category.Name)</a>
                }
            </nav>
            <div class="pos-service-results">
            <form asp-action="Index" method="get" class="d-flex gap-2 mb-3" role="search">
                <input type="hidden" name="services" value="true" />
                <input type="hidden" name="serviceCategoryId" value="@Model.ServiceCategoryId" />
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <label class="visually-hidden" for="serviceSearch">@(ar ? "البحث عن خدمة" : "Search alterations")</label>
                <input id="serviceSearch" name="serviceSearch" type="search" maxlength="100"
                       class="form-control" value="@Model.ServiceSearch"
                       placeholder="@(ar ? "اسم خدمة التعديل" : "Find alteration service")" />
                <button class="btn btn-primary" type="submit">@(ar ? "بحث" : "Search")</button>
            </form>
            <div class="row row-cols-2 row-cols-md-3 row-cols-xxl-4 g-2 pos-service-grid">
                @foreach (var service in Model.Services)
                {
                    <div class="col">
                        <button type="button" class="card pos-service w-100 h-100 text-start"
                                data-service-id="@service.ServiceId"
                                data-name="@service.Name" data-name-ar="@service.NameAr"
                                data-price="@service.Price.ToString("0.000", CultureInfo.InvariantCulture)">
                            <span class="pos-service-photo" aria-hidden="true">✂</span>
                            <span class="pos-service-card-body">
                                <strong>@(ar ? service.NameAr : service.Name)</strong>
                                <small>@service.Price.ToString("0.000", CultureInfo.InvariantCulture) KWD</small>
                            </span>
                        </button>
                    </div>
                }
            </div>
            @if (Model.Services.Count == 0)
            {
                <p class="text-secondary text-center py-4">@(ar ? "لا توجد خدمات مطابقة." : "No matching alterations.")</p>
            }
            @if (Model.ServiceTotalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="@(ar ? "صفحات الخدمات" : "Alteration pages")">
                    <span class="small text-secondary">@Model.ServicePage / @Model.ServiceTotalPages</span>
                    <div class="d-flex gap-2">
                        @if (Model.ServicePage > 1)
                        {
                            <a asp-action="Index" asp-route-services="true" asp-route-serviceSearch="@Model.ServiceSearch"
                               asp-route-servicePage="@(Model.ServicePage - 1)" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-serviceCategoryId="@Model.ServiceCategoryId" class="btn btn-outline-primary btn-sm">@(ar ? "السابق" : "Previous")</a>
                        }
                        @if (Model.ServicePage < Model.ServiceTotalPages)
                        {
                            <a asp-action="Index" asp-route-services="true" asp-route-serviceSearch="@Model.ServiceSearch"
                               asp-route-servicePage="@(Model.ServicePage + 1)" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-serviceCategoryId="@Model.ServiceCategoryId" class="btn btn-outline-primary btn-sm">@(ar ? "التالي" : "Next")</a>
                        }
                    </div>
                </nav>
            }
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        <section class="card filter-card pos-checkout">
            <div class="card-body p-3 p-md-4">
                <div class="pos-cart-header">
                    <h2 class="h5 mb-0 pos-order-heading"><svg class="pos-cart-heading-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 3h2l2.5 12h12l2-9H5"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg> @(ar ? "عناصر السلة" : "Cart Items") (<span id="cartCount">0</span>)</h2>
                    <div class="pos-cart-header-actions">
                        <span class="pos-order-number" aria-live="polite">
                            <span>@(ar ? "فاتورة" : "Invoice")</span>
                            <strong id="nextOrderNumber">@Model.NextInvoiceNumber</strong>
                        </span>
                        <button id="openFindInvoice" type="button" class="btn btn-outline-primary btn-sm"
                                aria-haspopup="dialog" aria-controls="findInvoiceDialog">@(ar ? "بحث عن فاتورة" : "Find Invoice")</button>
                        <button id="closeInvoiceButton" type="button" class="btn btn-outline-secondary btn-sm" hidden>
                            @(ar ? "فاتورة جديدة" : "New Bill")
                        </button>
                    </div>
                </div>
                <div id="newOrderCart">
                <form id="posCheckoutForm" asp-controller="Pos" asp-action="Save" method="post"
                      asp-antiforgery="true" class="pos-customer-form">
                    <div class="pos-customer-searches">
                        <div class="pos-customer-field">
                            <label for="customerSearch" class="form-label">@(ar ? "اسم العميل" : "Customer name")</label>
                            <input id="customerSearch" class="form-control" type="search" autocomplete="off"
                                   placeholder="@(ar ? "ابحث بالاسم" : "Search by name")" />
                        </div>
                        <div class="pos-customer-field">
                            <label for="customerMobileSearch" class="form-label">@(ar ? "رقم الهاتف" : "Mobile number")</label>
                            <input id="customerMobileSearch" class="form-control" type="search" inputmode="tel" autocomplete="off"
                                   placeholder="@(ar ? "ابحث برقم الهاتف" : "Search by mobile")" />
                        </div>
                        <div id="customerResults" class="list-group pos-customer-results" role="listbox"
                             aria-label="@(ar ? "نتائج العملاء" : "Matching customers")"></div>
                    </div>
                    <div class="pos-customer-details">
                        <div id="selectedCustomer" class="pos-selected-customer" role="status">@(ar ? "لم يتم اختيار عميل" : "No customer selected")</div>
                        <button id="openQuickCustomer" type="button" class="btn btn-outline-primary pos-new-customer">+ @(ar ? "عميل جديد" : "New customer")</button>
                        <div class="pos-delivery-field">
                            <label for="deliveryDate" class="form-label">@(ar ? "تاريخ التسليم" : "Delivery date") *</label>
                            <input id="deliveryDate" type="date" value="@today" min="@today" class="form-control" required />
                        </div>
                    </div>
                </form>
                <div class="pos-cart-columns" aria-hidden="true">
                    <span>@(ar ? "العنصر" : "Item")</span>
                    <span>@(ar ? "الكمية" : "Qty")</span>
                    <span>@(ar ? "سعر الوحدة" : "Unit price")</span>
                    <span>@(ar ? "المجموع" : "Total")</span>
                    <span></span>
                </div>
                    <div id="orderCart" class="pos-cart" aria-live="polite">
                        <p class="pos-empty-cart">@(ar ? "اختر العميل ثم اضغط على المنتج لإضافته." : "Choose a customer, then tap a product to add it.")</p>
                    </div>
                    <button id="viewAllCartItems" type="button" class="btn btn-outline-primary btn-sm align-self-start mt-1" hidden>
                        @(ar ? "عرض جميع العناصر" : "View All Items") (<span id="allCartItemCount">0</span>)
                    </button>
                    <hr />
                    @if (Model.EnablePosDiscount)
                    {
                        <div class="pos-discount-row">
                            <label for="posDiscountAmount">@(ar ? "خصم الطلب (د.ك)" : "Order discount (KWD)")</label>
                            <input id="posDiscountAmount" type="number" class="form-control" min="0" step="0.001" value="0.000" inputmode="decimal" />
                        </div>
                    }
                    <div class="d-flex align-items-baseline justify-content-between gap-2 small mb-2">
                        <span>@(ar ? "المجموع الفرعي" : "Subtotal")</span>
                        <span id="cartSubtotal">0.000 KWD</span>
                    </div>
                    <div class="pos-total-summary d-flex align-items-baseline justify-content-between gap-2">
                        <span>@(ar ? "المجموع" : "Total")</span>
                        <strong id="cartTotal" class="h4 mb-0">0.000 KWD</strong>
                    </div>
                    
                    <div id="posMessage" class="small mb-3" role="status" aria-live="polite"></div>
                    <div class="pos-payment-choice mt-3" role="group" aria-label="@(ar ? "حالة الدفع" : "Payment status")">
                        <button id="posChooseUnpaid" type="button" class="btn btn-primary" aria-pressed="true">UNPAID</button>
                        <button id="posChoosePaid" type="button" class="btn btn-outline-primary" aria-pressed="false">PAID</button>
                    </div>
                    <div class="pos-checkout-actions mt-2">
                        <button type="button" id="clearCartButton" class="btn btn-outline-secondary" disabled
                                title="@(ar ? "إفراغ السلة" : "Clear cart")" aria-label="@(ar ? "إفراغ السلة" : "Clear cart")">×</button>
                        <button type="submit" form="posCheckoutForm" id="saveOrderButton" class="btn btn-primary w-100"
                                disabled>@(ar ? "حفظ وطباعة" : "Save & Print")</button>
                    </div>
                </div>
                <section id="boundInvoice" hidden aria-label="@(ar ? "الفاتورة المحفوظة" : "Saved invoice")">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                        <strong id="boundInvoiceCustomer"></strong>
                        <span id="boundInvoiceStatus" class="badge text-bg-light border text-dark"></span>
                    </div>
                    <p class="small text-secondary mb-3">
                        <span id="boundInvoiceMobile"></span>
                        <span class="mx-1">·</span><span id="boundInvoiceDelivery"></span>
                        <span class="mx-1">·</span><span id="boundOrderStatus"></span>
                    </p>
                    <div class="pos-cart-columns" aria-hidden="true">
                        <span>@(ar ? "العنصر" : "Item")</span>
                        <span>@(ar ? "الكمية" : "Qty")</span>
                        <span>@(ar ? "سعر الوحدة" : "Unit price")</span>
                        <span>@(ar ? "المجموع" : "Total")</span>
                        <span></span>
                    </div>
                    <div id="boundInvoiceItems" class="pos-cart"></div>
                    <button id="viewAllInvoiceItems" type="button" class="btn btn-outline-primary btn-sm align-self-start mt-1" hidden>
                        @(ar ? "عرض جميع العناصر" : "View All Items") (<span id="allInvoiceItemCount">0</span>)
                    </button>
                    <hr />
                    <div class="d-flex justify-content-between small mb-2">
                        <span>@(ar ? "المجموع الفرعي" : "Subtotal")</span>
                        <span id="boundInvoiceSubtotal"></span>
                    </div>
                    <div id="boundInvoiceDiscountRow" class="d-flex justify-content-between small mb-2" hidden>
                        <span>@(ar ? "خصم الطلب" : "Order discount")</span>
                        <span id="boundInvoiceDiscount"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>@(ar ? "المجموع" : "Total")</span>
                        <strong id="boundInvoiceTotal"></strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-2">
                        <span>@(ar ? "المدفوع" : "Paid")</span>
                        <span id="boundInvoicePaid"></span>
                    </div>
                    <div class="pos-total-summary d-flex justify-content-between mb-3">
                        <span>@(ar ? "المتبقي" : "Balance due")</span>
                        <strong id="boundInvoiceBalance"></strong>
                    </div>
                    <button id="boundInvoicePayment" type="button" class="btn btn-primary w-100">@(ar ? "تحصيل المتبقي" : "Receive Balance")</button>
                </section>
            </div>
        </section>
    </div>
</div>
<div id="posToast" class="pos-toast" hidden role="status" aria-live="polite" aria-atomic="true">
    <span id="posToastText"></span>
    <button id="closePosToast" type="button" class="btn-close" aria-label="@(ar ? "إغلاق الرسالة" : "Dismiss message")"></button>
</div>
<dialog id="findInvoiceDialog" class="pos-dialog pos-find-invoice-dialog" aria-labelledby="findInvoiceTitle">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <h2 id="findInvoiceTitle" class="h5 mb-0">@(ar ? "البحث عن فاتورة" : "Find Invoice")</h2>
        <button id="cancelFindInvoice" type="button" class="btn btn-outline-secondary btn-sm"
                aria-label="@(ar ? "إغلاق" : "Close")">×</button>
    </div>
    <form id="findInvoiceForm" role="search">
        <label for="findInvoiceNumber" class="form-label">@(ar ? "رقم الفاتورة" : "Invoice Number")</label>
        <input id="findInvoiceNumber" type="search" class="form-control" maxlength="20"
               inputmode="numeric" pattern="[0-9]+" autocomplete="off" placeholder="105" required />
        <p id="findInvoiceMessage" class="small text-secondary mt-2 mb-3" role="status" aria-live="polite"></p>
        <button id="findInvoiceButton" type="submit" class="btn btn-primary w-100">@(ar ? "فتح الفاتورة" : "Open Invoice")</button>
    </form>
</dialog>
<dialog id="cartItemsDialog" class="pos-dialog pos-cart-items-dialog" aria-labelledby="allCartTitle">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <h2 id="allCartTitle" class="h5 mb-0">@(ar ? "جميع عناصر السلة" : "All Cart Items")</h2>
        <button id="closeCartItemsDialog" type="button" class="btn btn-outline-secondary btn-sm"
                aria-label="@(ar ? "إغلاق" : "Close")">×</button>
    </div>
    <div id="allCartItemsContainer"></div>
</dialog>
<dialog id="posPaymentDialog" class="pos-dialog pos-payment-dialog" aria-labelledby="posPaymentTitle">
    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
        <div><span class="eyebrow">@(ar ? "تحصيل الدفع" : "COLLECT PAYMENT")</span>
            <h2 id="posPaymentTitle" class="h5 mt-1 mb-0">@(ar ? "الدفع" : "Payment")</h2></div>
        <button id="closePaymentDialog" type="button" class="btn btn-outline-secondary btn-sm" aria-label="@(ar ? "إغلاق" : "Close")">×</button>
    </div>
    <div class="pos-payment-total mb-3">
        <span>@(ar ? "المبلغ المستحق" : "Net Payable")</span>
        <strong id="posPaymentDue">0.000 KWD</strong>
    </div>
    <div id="posPaymentMethods" class="pos-payment-methods mb-3" role="group" aria-label="@(ar ? "طريقة الدفع" : "Payment method")">
        <button type="button" data-pos-method="Cash" class="btn btn-primary" aria-pressed="true">Cash</button>
        <button type="button" data-pos-method="KNET" class="btn btn-outline-primary" aria-pressed="false">KNET</button>
        <button type="button" data-pos-method="Card" class="btn btn-outline-primary" aria-pressed="false">WAMD</button>
        <button type="button" data-pos-method="Split" class="btn btn-outline-primary" aria-pressed="false">Split</button>
    </div>
    <div id="posSinglePayment">
        <label for="posPaymentAmount" id="posPaymentAmountLabel" class="form-label">@(ar ? "النقد المستلم (د.ك)" : "Cash Received (KWD)")</label>
        <input id="posPaymentAmount" class="form-control mb-2" inputmode="decimal" autocomplete="off" placeholder="0.000" />
    </div>
    <div id="posSplitPayment" hidden>
        <div class="row g-2">
            <div class="col-12"><label for="posSplitCash" class="form-label">Cash (KWD)</label>
                <input id="posSplitCash" class="form-control" inputmode="decimal" placeholder="0.000" /></div>
            <div class="col-6"><label for="posSplitKnet" class="form-label">KNET (KWD)</label>
                <input id="posSplitKnet" class="form-control" inputmode="decimal" placeholder="0.000" /></div>
            <div class="col-6"><label for="posSplitWamd" class="form-label">WAMD (KWD)</label>
                <input id="posSplitWamd" class="form-control" inputmode="decimal" placeholder="0.000" /></div>
        </div>
        <div class="mt-2"><label for="posSplitCashReceived" class="form-label">@(ar ? "النقد المستلم (اختياري)" : "Cash Received (optional)")</label>
            <input id="posSplitCashReceived" class="form-control" inputmode="decimal" placeholder="0.000" /></div>
    </div>
    <div class="d-flex justify-content-between mt-3"><span>@(ar ? "المدفوع" : "Payment Total")</span><strong id="posPaymentEntered">0.000 KWD</strong></div>
    <div class="d-flex justify-content-between mt-2"><span>@(ar ? "المتبقي" : "Remaining Balance")</span><strong id="posPaymentRemaining">0.000 KWD</strong></div>
    <div class="d-flex justify-content-between mt-2"><span>@(ar ? "الباقي للعميل" : "Cash Change")</span><strong id="posPaymentChange">0.000 KWD</strong></div>
    <p id="posPaymentError" class="small text-danger mt-2" role="alert" aria-live="polite"></p>
    <button id="confirmPosPayment" type="button" class="btn btn-primary w-100" disabled>
        @(ar ? "تأكيد الدفع والطباعة" : "Confirm Payment & Print")
    </button>
</dialog>
<dialog id="productDialog" class="pos-dialog" aria-labelledby="dialogTitle">
    <form method="dialog" class="pos-dialog-header d-flex justify-content-between align-items-center gap-3">
        <h2 id="dialogTitle" class="h5 mb-0"></h2>
        <button type="submit" class="btn btn-outline-secondary" aria-label="@(ar ? "إغلاق" : "Close")">×</button>
    </form>
    <div id="productDialogBody" class="pos-dialog-body">
        <div id="dialogFields"></div>
    </div>
    <div class="pos-dialog-actions d-flex gap-2">
        <button type="button" id="addProductButton" class="btn btn-primary">@(ar ? "إضافة للطلب" : "Add to order")</button>
        <button type="button" id="cancelProductButton" class="btn btn-outline-secondary">@(ar ? "إلغاء" : "Cancel")</button>
    </div>
</dialog>


<dialog id="quickCustomerDialog" class="pos-dialog" aria-labelledby="quickCustomerTitle">
    <form method="dialog" class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <h2 id="quickCustomerTitle" class="h5 mb-0">@(ar ? "عميل جديد" : "New customer")</h2>
        <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="@(ar ? "إغلاق" : "Close")">×</button>
    </form>
    <form id="quickCustomerForm">
        <label for="quickCustomerName" class="form-label">@(ar ? "الاسم بالإنجليزية" : "English name") *</label>
        <input id="quickCustomerName" name="Name" class="form-control mb-3" maxlength="120" required />
        <label for="quickCustomerNameAr" class="form-label">@(ar ? "الاسم بالعربية" : "Arabic name") *</label>
        <input id="quickCustomerNameAr" name="NameAr" class="form-control mb-3" maxlength="120" dir="rtl" lang="ar" required />
        <label for="quickCustomerMobile" class="form-label">@(ar ? "رقم الجوال" : "Mobile number") *</label>
        <input id="quickCustomerMobile" name="Mobile" class="form-control mb-3" type="tel" maxlength="20" required />
        <p id="quickCustomerError" class="small text-danger" role="alert" aria-live="polite"></p>
        <button id="saveQuickCustomer" type="submit" class="btn btn-primary w-100">@(ar ? "حفظ واختيار العميل" : "Save & select customer")</button>
    </form>
</dialog>

@section Scripts
{
    <script src="~/js/pos.js" asp-append-version="true" defer></script>
}

