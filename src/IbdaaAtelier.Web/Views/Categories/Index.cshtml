@model CategoryListPage
@using System.Globalization
@{
    ViewData["Title"] = "Product categories";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA · ADMIN</span>
        <h1 class="section-title mt-2">@(ar ? "فئات المنتجات" : "Product categories")</h1>
        <p class="text-secondary mb-0">@(ar ? "إدارة الفئات والفئات الفرعية." : "Manage categories and subcategories.")</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@(ar ? "فئة جديدة" : "Add category")</a>
</section>
@if (TempData["Message"] is string notice)
{
    <div class="alert alert-success" role="status">@notice</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<form method="get" class="d-flex gap-2 mb-4" role="search">
    <input type="search" class="form-control" name="search" maxlength="100" value="@Model.Search" placeholder="@(ar ? "ابحث عن فئة" : "Search categories")" aria-label="@(ar ? "بحث" : "Search categories")" />
    <button class="btn btn-primary" type="submit">@(ar ? "بحث" : "Search")</button>
</form>
<div class="card filter-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr>
                <th scope="col">@(ar ? "الاسم" : "Category")</th>
                <th scope="col">@(ar ? "الفئة الرئيسية" : "Parent")</th>
                <th scope="col">@(ar ? "الترتيب" : "Order")</th>
                <th scope="col">@(ar ? "الحالة" : "Status")</th>
                <th scope="col" class="text-end">@(ar ? "إجراء" : "Actions")</th>
            </tr></thead>
            <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td><strong>@category.Name</strong><span class="d-block text-secondary" lang="ar">@category.NameAr</span></td>
                    <td>@(category.ParentName.Length > 0 ? category.ParentName : "—")</td>
                    <td>@category.DisplayOrder</td>
                    <td><span class="badge @(category.IsActive ? "text-bg-success" : "text-bg-secondary")">@(category.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2 flex-wrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.CategoryId">@(ar ? "تعديل" : "Edit")</a>
                            <form asp-action="Toggle" asp-route-id="@category.CategoryId" method="post" asp-antiforgery="true" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@(category.IsActive ? (ar ? "تعطيل" : "Deactivate") : (ar ? "تفعيل" : "Activate"))</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Categories.Count == 0)
            {
                <tr><td colspan="5" class="py-5 text-center text-secondary">@(ar ? "لا توجد فئات." : "No categories found.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav aria-label="Category pages" class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-secondary">@(ar ? "صفحة" : "Page") @Model.Page / @Model.TotalPages</span>
        <div class="d-flex gap-2">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">@(ar ? "السابق" : "Previous")</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">@(ar ? "التالي" : "Next")</a>
            }
        </div>
    </nav>
}
