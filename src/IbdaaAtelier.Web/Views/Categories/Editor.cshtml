@model CategoryForm
@using System.Globalization
@{
    var editing = Model.CategoryId > 0;
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = editing ? "Edit category" : "Add category";
    var parents = (IEnumerable<ProductCategory>)(ViewBag.Parents ?? Array.Empty<ProductCategory>());
}
<section class="mb-4">
    <span class="eyebrow">IBDAA · ADMIN</span>
    <h1 class="section-title mt-2">@(editing ? (ar ? "تعديل الفئة" : "Edit category") : (ar ? "فئة جديدة" : "Add category"))</h1>
    <p class="text-secondary">@(ar ? "أدخل التفاصيل الأساسية باللغتين." : "Enter the category details in English and Arabic.")</p>
</section>
<div class="card filter-card">
    <div class="card-body p-4 p-lg-5">
        <form asp-controller="Categories" asp-action="@(editing ? "Edit" : "Create")" method="post" asp-antiforgery="true">
            <input asp-for="CategoryId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">English name *</label>
                    <input asp-for="Name" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NameAr" class="form-label">الاسم بالعربية *</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" lang="ar" maxlength="100" required />
                    <span asp-validation-for="NameAr" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ParentCategoryId" class="form-label">@(ar ? "الفئة الرئيسية" : "Parent category")</label>
                    <select asp-for="ParentCategoryId" class="form-select">
                        <option value="">@(ar ? "فئة رئيسية" : "Top-level category")</option>
                        @foreach (var parent in parents)
                        {
                            <option value="@parent.CategoryId">@parent.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ParentCategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DisplayOrder" class="form-label">@(ar ? "الترتيب" : "Display order")</label>
                    <input asp-for="DisplayOrder" type="number" min="0" max="100000" class="form-control" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label">@(ar ? "الوصف بالإنجليزية" : "English description")</label>
                    <textarea asp-for="Description" rows="3" class="form-control" maxlength="1000"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DescriptionAr" class="form-label">@(ar ? "الوصف بالعربية" : "Arabic description")</label>
                    <textarea asp-for="DescriptionAr" rows="3" class="form-control" maxlength="1000" dir="rtl" lang="ar"></textarea>
                    <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">@(ar ? "حفظ" : "Save category")</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@(ar ? "إلغاء" : "Cancel")</a>
                @if (editing)
                {
                    <a class="btn btn-outline-primary" asp-controller="ProductSetup" asp-action="Category" asp-route-categoryId="@Model.CategoryId">@(ar ? "قياسات الفئة" : "Category measurements")</a>
                }
            </div>
        </form>
    </div>
</div>
