@model IbdaaAtelier.Web.Models.Masters.AdminDashboardPage
@using System.Globalization
@{
    ViewData["Title"] = "Administration";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="admin-hero mb-4">
    <span class="eyebrow">IBDAA ATELIER · ADMIN</span>
    <h1 class="section-title mt-2 mb-2">@(ar ? "مرحباً، المسؤول" : "Welcome, Admin")<br />IBDAA Atelier</h1>
    <p class="mb-0">@(ar ? "بوابة الإدارة والعمليات" : "Management & Operations Portal")</p>
</section>
<form method="get" asp-action="Index" class="card filter-card mb-3">
    <div class="card-body p-3 d-flex flex-wrap gap-2 align-items-end">
        <div><label for="dashboardPeriod" class="form-label">@(ar ? "الفترة" : "Period")</label><select id="dashboardPeriod" class="form-select" name="period">
            <option value="today" selected="@(Model.Period == "today")">@(ar ? "اليوم" : "Today")</option>
            <option value="yesterday" selected="@(Model.Period == "yesterday")">@(ar ? "أمس" : "Yesterday")</option>
            <option value="week" selected="@(Model.Period == "week")">@(ar ? "هذا الأسبوع" : "This week")</option>
            <option value="month" selected="@(Model.Period == "month")">@(ar ? "هذا الشهر" : "This month")</option>
            <option value="custom" selected="@(Model.Period == "custom")">@(ar ? "مخصص" : "Custom")</option>
        </select></div>
        <div><label for="dashboardFrom" class="form-label">@(ar ? "من" : "From")</label><input id="dashboardFrom" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div><label for="dashboardTo" class="form-label">@(ar ? "إلى" : "To")</label><input id="dashboardTo" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <button class="btn btn-primary" type="submit">@(ar ? "تطبيق" : "Apply")</button>
    </div>
</form>
<div class="row g-3 mb-3 admin-kpis">
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3"><small>@(ar ? "إجمالي الطلبات" : "Total Orders")</small><div class="h4 mb-0">@Model.OrderCount</div><span class="small">@(ar ? "في الفترة المحددة" : "In selected period")</span></div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3"><small class="text-secondary">@(ar ? "العملاء" : "Customers")</small><div class="h4 mb-0">@Model.CustomerCount</div><span class="small text-secondary">@(ar ? "مسجل" : "Registered")</span></div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3"><small class="text-secondary">@(ar ? "جاهزة للتسليم" : "Ready for delivery")</small><div class="h4 mb-0">@Model.ReadyForDelivery</div><span class="small text-secondary">@(ar ? "الطلبات الحالية" : "Current orders")</span></div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3"><small class="text-secondary">@(ar ? "المدفوعات المحصلة" : "Payments Collected")</small><div class="h4 mb-0">@Model.Collected.ToString("0.000", CultureInfo.InvariantCulture) <small>KWD</small></div><span class="small text-secondary">@(ar ? "في الفترة المحددة" : "In selected period")</span></div></div></div>
</div>
<div class="dashboard-main-grid">
    <div class="dashboard-left-stack">
        <section class="card filter-card admin-master-links"><div class="card-body p-3 p-md-4">
            <h2 class="h5 mb-3 dashboard-panel-title">@(ar ? "إدارة البيانات" : "Manage Masters")</h2>
            <div class="row row-cols-2 row-cols-lg-4 g-3">
                <div class="col"><a class="admin-master-link" asp-controller="Products" asp-action="Index"><span aria-hidden="true">◇</span>@(ar ? "المنتجات" : "Products")</a></div>
                <div class="col"><a class="admin-master-link" asp-controller="Categories" asp-action="Index"><span aria-hidden="true">▤</span>@(ar ? "الفئات" : "Categories")</a></div>
                <div class="col"><a class="admin-master-link" asp-controller="Services" asp-action="Index"><span aria-hidden="true">✂</span>@(ar ? "خدمات التعديل" : "Services")</a></div>
                <div class="col"><a class="admin-master-link" asp-controller="Products" asp-action="Index"><span aria-hidden="true">◉</span>@(ar ? "المقاسات" : "Sizes / Measurements")</a></div>
            </div>
        </div></section>
        <section class="card filter-card"><div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><h2 class="h5 mb-0 dashboard-panel-title">@(ar ? "الطلبات الأخيرة" : "Recent Orders")</h2><a asp-controller="Orders" asp-action="Index">@(ar ? "عرض الكل" : "View all") →</a></div>
            <div class="table-responsive"><table class="table table-sm align-middle mb-0 dashboard-recent-table"><thead><tr><th scope="col">@(ar ? "رقم الطلب" : "Order No.")</th><th scope="col">@(ar ? "العميل" : "Customer")</th><th scope="col">KWD</th><th scope="col">@(ar ? "الحالة" : "Status")</th><th scope="col">@(ar ? "التسليم" : "Delivery")</th></tr></thead><tbody>
                @foreach (var order in Model.RecentOrders) { <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId">@order.OrderNumber</a></td><td>@order.CustomerName</td><td>@order.Total.ToString("0.000", CultureInfo.InvariantCulture)</td><td><span class="dashboard-status">@order.Status</span></td><td>@order.DeliveryDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td></tr> }
                @if (Model.RecentOrders.Count == 0) { <tr><td colspan="5" class="text-secondary py-3">@(ar ? "لا توجد طلبات بعد." : "No orders yet.")</td></tr> }
            </tbody></table></div>
        </div></section>
        @if (Model.PaymentMethods.Count > 0) { <section class="card filter-card"><div class="card-body p-3 p-md-4"><h2 class="h5 dashboard-panel-title">@(ar ? "التحصيل حسب طريقة الدفع" : "Collection by payment method")</h2><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Method</th><th class="text-end">Received</th><th class="text-end">Refunded</th><th class="text-end">Net</th></tr></thead><tbody>@foreach (var method in Model.PaymentMethods) { <tr><td>@(method.Method == "Card" ? "WAMD" : method.Method)</td><td class="text-end">@method.Received.ToString("0.000", CultureInfo.InvariantCulture)</td><td class="text-end">@method.Refunded.ToString("0.000", CultureInfo.InvariantCulture)</td><td class="text-end">@method.Net.ToString("0.000", CultureInfo.InvariantCulture)</td></tr> }</tbody></table></div></div></section> }
    </div>
    <div class="dashboard-right-stack">
        <section class="card filter-card"><div class="card-body p-3"><h2 class="h5 dashboard-panel-title">@(ar ? "روابط سريعة" : "Quick Links")</h2><div class="dashboard-quick-links">
            <a class="btn" asp-controller="Customers" asp-action="Index">@(ar ? "إدارة العملاء" : "Manage Customers") →</a>
            <a class="btn" asp-controller="Orders" asp-action="Index">@(ar ? "الطلبات والتسليم" : "Orders & Delivery") →</a>
            <a class="btn" asp-controller="Reports" asp-action="Index">@(ar ? "تقارير المدفوعات" : "Payment Collections") →</a>
            <a class="btn" asp-controller="Register" asp-action="Index">@(ar ? "الصندوق النقدي" : "Cash Register") →</a>
            <a class="btn" asp-controller="Users" asp-action="Index">@(ar ? "المستخدمون والصلاحيات" : "Users & Permissions") →</a>
            <a class="btn" asp-controller="ShopSettings" asp-action="Index">@(ar ? "إعدادات المتجر" : "System Settings") →</a>
        </div></div></section>
        <section class="card filter-card"><div class="card-body p-3"><h2 class="h5 dashboard-panel-title">@(ar ? "الوضع الحالي" : "Current operational status")</h2>
            <div class="dashboard-glance-row"><span>@(ar ? "تسليمات متأخرة" : "Overdue deliveries")</span><strong>@Model.PendingDeliveries</strong></div>
            <div class="dashboard-glance-row"><span>@(ar ? "جاهزة للتسليم" : "Ready for delivery")</span><strong>@Model.ReadyForDelivery</strong></div>
            <div class="dashboard-glance-row"><span>@(ar ? "الرصيد المستحق" : "Outstanding balance")</span><strong>@Model.Outstanding.ToString("0.000", CultureInfo.InvariantCulture)</strong></div>
            <div class="dashboard-glance-row"><span>@(ar ? "المبالغ المستردة" : "Refunded")</span><strong>@Model.Refunded.ToString("0.000", CultureInfo.InvariantCulture)</strong></div>
        </div></section>
    </div>
</div>

@section Scripts
{
    <script>
        const dashboardPeriod = document.getElementById("dashboardPeriod");
        for (const id of ["dashboardFrom", "dashboardTo"])
            document.getElementById(id).addEventListener("change", () => dashboardPeriod.value = "custom");
    </script>
}
