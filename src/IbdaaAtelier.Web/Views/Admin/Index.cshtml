@model IbdaaAtelier.Web.Models.Masters.AdminDashboardPage
@using System.Globalization
@{
    ViewData["Title"] = "Administration";
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="page-heading mb-4">
    <span class="eyebrow">IBDAA ATELIER · ADMIN</span>
    <h1 class="section-title mt-2">@(isArabic ? "إدارة المتجر" : "Shop administration")</h1>
    <p class="text-secondary">@(isArabic ? "تتوفر الإعدادات والأقسام حسب صلاحيات المستخدم." : "Manage shop records securely with your administrator account.")</p>
</section>
<form method="get" asp-action="Index" class="card filter-card mb-4">
    <div class="card-body p-3 d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label for="dashboardPeriod" class="form-label">@(isArabic ? "الفترة" : "Period")</label>
            <select id="dashboardPeriod" class="form-select" name="period">
                <option value="today" selected="@(Model.Period == "today")">@(isArabic ? "اليوم" : "Today")</option>
                <option value="yesterday" selected="@(Model.Period == "yesterday")">@(isArabic ? "أمس" : "Yesterday")</option>
                <option value="week" selected="@(Model.Period == "week")">@(isArabic ? "هذا الأسبوع" : "This week")</option>
                <option value="month" selected="@(Model.Period == "month")">@(isArabic ? "هذا الشهر" : "This month")</option>
                <option value="custom" selected="@(Model.Period == "custom")">@(isArabic ? "مخصص" : "Custom")</option>
            </select>
        </div>
        <div>
            <label for="dashboardFrom" class="form-label">@(isArabic ? "من" : "From")</label>
            <input id="dashboardFrom" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="dashboardTo" class="form-label">@(isArabic ? "إلى" : "To")</label>
            <input id="dashboardTo" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <button class="btn btn-primary" type="submit">@(isArabic ? "تطبيق" : "Apply")</button>
    </div>
</form>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "المبيعات" : "Sales")</small>
        <div class="h4 mt-2 mb-0">@Model.Sales.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "التحصيل" : "Received")</small>
        <div class="h4 mt-2 mb-0">@Model.Collected.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "المبالغ المستردة" : "Refunded")</small>
        <div class="h4 mt-2 mb-0">@Model.Refunded.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "الرصيد المستحق" : "Outstanding (all active orders)")</small>
        <div class="h4 mt-2 mb-0">@Model.Outstanding.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-sm-4"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "عدد الطلبات" : "Orders in period")</small>
        <div class="h4 mt-2 mb-0">@Model.OrderCount</div>
    </div></div></div>
    <div class="col-sm-4"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "طلبات متأخرة" : "Overdue deliveries")</small>
        <div class="h4 mt-2 mb-0">@Model.PendingDeliveries</div>
    </div></div></div>
    <div class="col-sm-4"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(isArabic ? "جاهزة للتسليم" : "Ready for delivery")</small>
        <div class="h4 mt-2 mb-0">@Model.ReadyForDelivery</div>
    </div></div></div>
</div>
@if (Model.PaymentMethods.Count > 0)
{
    <section class="card filter-card mb-4"><div class="card-body p-3 p-md-4">
        <h2 class="h5">@(isArabic ? "التحصيل حسب طريقة الدفع" : "Collection by payment method")</h2>
        <div class="table-responsive"><table class="table table-sm align-middle mb-0">
            <thead><tr>
                <th scope="col">@(isArabic ? "الطريقة" : "Method")</th>
                <th scope="col" class="text-end">@(isArabic ? "المقبوض" : "Received")</th>
                <th scope="col" class="text-end">@(isArabic ? "المسترد" : "Refunded")</th>
                <th scope="col" class="text-end">@(isArabic ? "الصافي" : "Net")</th>
            </tr></thead>
            <tbody>
            @foreach (var method in Model.PaymentMethods)
            {
                <tr>
                    <td>@method.Method</td>
                    <td class="text-end">@method.Received.ToString("0.000", CultureInfo.InvariantCulture)</td>
                    <td class="text-end">@method.Refunded.ToString("0.000", CultureInfo.InvariantCulture)</td>
                    <td class="text-end">@method.Net.ToString("0.000", CultureInfo.InvariantCulture)</td>
                </tr>
            }
            </tbody>
        </table></div>
    </div></section>
}
<h2 class="h5 mb-3">@(isArabic ? "إدارة المتجر" : "Manage shop")</h2>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card feature-card h-100"><div class="card-body p-4">
            <h2 class="h5">@(isArabic ? "فئات المنتجات" : "Product categories")</h2>
            <p class="text-secondary">@(isArabic ? "إدارة الفئات والفئات الفرعية." : "Manage categories and subcategories.")</p>
            <a class="btn btn-outline-primary" asp-controller="Categories" asp-action="Index">@(isArabic ? "إدارة الفئات" : "Manage categories")</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card feature-card h-100"><div class="card-body p-4">
            <h2 class="h5">@(isArabic ? "كتالوج المنتجات" : "Product catalogue")</h2>
            <p class="text-secondary">@(isArabic ? "إدارة المنتجات والأسعار." : "Manage products, availability and prices.")</p>
            <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">@(isArabic ? "إدارة المنتجات" : "Manage products")</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card feature-card h-100"><div class="card-body p-4">
            <h2 class="h5">@(isArabic ? "خدمات التعديل" : "Alteration services")</h2>
            <p class="text-secondary">@(isArabic ? "إدارة فئات الخدمات والأسعار." : "Manage tailoring services, categories and KWD rates.")</p>
            <a class="btn btn-outline-primary" asp-controller="Services" asp-action="Index">@(isArabic ? "إدارة الخدمات" : "Manage services")</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card feature-card h-100"><div class="card-body p-4">
            <h2 class="h5">@(isArabic ? "المستخدمون والصلاحيات" : "Users and access")</h2>
            <p class="text-secondary">@(isArabic ? "إدارة حسابات الموظفين وكلمات المرور." : "Manage shop accounts, roles and password resets.")</p>
            <a class="btn btn-outline-primary" asp-controller="Users" asp-action="Index">@(isArabic ? "إدارة المستخدمين" : "Manage users")</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card feature-card h-100"><div class="card-body p-4">
            <h2 class="h5">@(isArabic ? "إعدادات المتجر" : "Shop settings")</h2>
            <p class="text-secondary">@(isArabic ? "إدارة بيانات النشاط التجاري للفاتورة." : "Manage bilingual business and invoice header details.")</p>
            <a class="btn btn-outline-primary" asp-controller="ShopSettings" asp-action="Index">@(isArabic ? "إدارة الإعدادات" : "Manage settings")</a>
        </div></div>
    </div>
</div>
