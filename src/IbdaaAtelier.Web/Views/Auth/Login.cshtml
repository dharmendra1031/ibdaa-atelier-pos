@model IbdaaAtelier.Web.Models.Security.LoginForm
@using System.Globalization
@{
    ViewData["Title"] = "Sign in";
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="auth-wrap">
    <div class="auth-showcase" aria-hidden="true">
        <span class="auth-showcase-mark">IBDAA <small>ATELIER</small><em>Fashion · Tailoring · Alteration</em></span>
        <div class="auth-showcase-content">
            <span class="eyebrow">IBDAA ATELIER · KUWAIT</span>
            <h2>Welcome to<br />IBDAA Atelier</h2>
            <p class="auth-showcase-subtitle">Shop Management System</p>
            <p>A complete, elegant solution to manage your tailoring and alteration business.</p>
            <div class="auth-services" aria-hidden="true">
                <span>✂ <small>Tailoring</small></span>
                <span>◇ <small>Alterations</small></span>
                <span>♧ <small>Shop Management</small></span>
            </div>
        </div>
    </div>
    <div class="card border-0 auth-card">
        <div class="card-body p-4 p-md-5">
            <span class="eyebrow">IBDAA ATELIER · SECURE ACCESS</span>
            <h1 class="h2 mt-3 mb-2">@(isArabic ? "تسجيل الدخول إلى إبداع أتيليه" : "Sign In to IBDAA Atelier")</h1>
            <p class="text-secondary mb-4">@(isArabic ? "سجّل الدخول للوصول إلى مساحة العمل المخصصة لك." : "Access your workspace to manage your shop.")</p>
            <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post" asp-antiforgery="true">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">@(isArabic ? "اسم المستخدم" : "Username")</label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">@(isArabic ? "كلمة المرور" : "Password")</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 auth-submit">
                    <span class="auth-submit-label">@(isArabic ? "تسجيل الدخول" : "Sign In")</span>
                    <span class="auth-submit-loading d-none"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@(isArabic ? "جارٍ تسجيل الدخول..." : "Signing in...")</span>
                </button>
            </form>
        </div>
        <div class="login-keifac-credit"><partial name="_KeifacCredit" /></div>
    </div>
</section>
@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', function (event) {
            if (!this.checkValidity()) return;
            const button = this.querySelector('.auth-submit');
            if (button.disabled) { event.preventDefault(); return; }
            button.disabled = true;
            button.querySelector('.auth-submit-label').classList.add('d-none');
            button.querySelector('.auth-submit-loading').classList.remove('d-none');
        });
    </script>
}
