@model IbdaaAtelier.Web.Models.Masters.ShopSettingsForm
@using System.Globalization
@{
    ViewData["Title"] = "Shop settings";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="mb-4">
    <span class="eyebrow">IBDAA ATELIER · ADMIN</span>
    <h1 class="section-title mt-2">@(ar ? "إعدادات المتجر" : "Shop settings")</h1>
    <p class="text-secondary">@(ar ? "بيانات النشاط التجاري للفواتير والتقارير." : "Maintain business details for future RDLC invoices and reports.")</p>
</section>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="card filter-card">
    <div class="card-body p-4 p-lg-5">
        <form asp-controller="ShopSettings" asp-action="Save" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="BusinessName" class="form-label">English business name *</label>
                    <input asp-for="BusinessName" class="form-control" maxlength="150" required />
                    <span asp-validation-for="BusinessName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="BusinessNameAr" class="form-label">الاسم التجاري بالعربية *</label>
                    <input asp-for="BusinessNameAr" class="form-control" maxlength="150" dir="rtl" lang="ar" required />
                    <span asp-validation-for="BusinessNameAr" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Mobile" class="form-label">@(ar ? "رقم الهاتف" : "Phone number")</label>
                    <input asp-for="Mobile" class="form-control" maxlength="25" type="tel" />
                    <span asp-validation-for="Mobile" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" maxlength="150" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Address" class="form-label">English address</label>
                    <textarea asp-for="Address" class="form-control" rows="3" maxlength="500"></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AddressAr" class="form-label">العنوان بالعربية</label>
                    <textarea asp-for="AddressAr" class="form-control" rows="3" maxlength="500" dir="rtl" lang="ar"></textarea>
                    <span asp-validation-for="AddressAr" class="text-danger small"></span>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
            {
                @if (Model.LogoPath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="alert alert-warning">@(ar ? "يُرجى رفع شعار PNG أو JPEG لطباعته في الفواتير." : "Re-upload this logo as PNG or JPEG so it can print on invoices.")</p>
                }
                <div class="mt-4">
                    <span class="form-label d-block">@(ar ? "الشعار الحالي" : "Current logo")</span>
                    <img src="@Model.LogoPath" alt="Business logo" loading="lazy" style="max-width:180px;max-height:100px;object-fit:contain" />
                </div>
            }
            <div class="mt-4">
                <label asp-for="ReceiptFooter" class="form-label">@(ar ? "رسالة الشكر أسفل الفاتورة" : "Invoice thank-you message")</label>
                <textarea asp-for="ReceiptFooter" class="form-control" rows="2" maxlength="500"></textarea>
                <span asp-validation-for="ReceiptFooter" class="text-danger small"></span>
                <p class="small text-secondary mb-0">@(ar ? "تظهر في فاتورة A4 وإيصال 80 مم." : "Printed at the bottom of A4 and 80mm invoices.")</p>
            </div>
            <div class="form-check mt-4">
                <input asp-for="RequireRegisterOpen" class="form-check-input" />
                <label asp-for="RequireRegisterOpen" class="form-check-label">
                    @(ar ? "اشتراط فتح صندوق النقد قبل استقبال المدفوعات والمبالغ المستردة" : "Require an open cash register before receiving payments or refunds")
                </label>
                <p class="small text-secondary mb-0">@(ar ? "عند إيقاف الإعداد يمكن قبول مدفوعات غير مرتبطة بجلسة الصندوق." : "When disabled, payments outside a register session remain possible and are not included in a session closing.")</p>
            </div>
            <div class="form-check mt-4">
                <input asp-for="EnablePosDiscount" class="form-check-input" />
                <label asp-for="EnablePosDiscount" class="form-check-label">@(ar ? "السماح بخصم الطلب في نقطة البيع" : "Allow order discount in POS")</label>
                <p class="small text-secondary mb-0">@(ar ? "عند الإيقاف لا يظهر حقل الخصم ويرفض الخادم أي خصم جديد." : "When off, the discount field is hidden and new discounts are rejected by the server.")</p>
            </div>
            <div class="form-check form-switch mt-4">
                <input asp-for="OpenInvoicePdfInNewTab" class="form-check-input" role="switch" />
                <label asp-for="OpenInvoicePdfInNewTab" class="form-check-label">
                    @(ar ? "فتح PDF الفاتورة في علامة تبويب جديدة" : "Open invoice PDF in a new tab")
                </label>
                <p class="small text-secondary mb-0">
                    @(ar ? "عند الإيقاف، تُرسل فاتورة RDLC مباشرة إلى الطابعة الافتراضية على جهاز Windows الذي يشغّل التطبيق."
                          : "When off, the RDLC invoice prints directly to the default printer on the Windows PC running this app.")
                </p>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">@(ar ? "حفظ" : "Save settings")</button>
                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">@(ar ? "رجوع" : "Back")</a>
            </div>
        </form>
        <hr class="my-4" />
        <h2 class="h5">@(ar ? "شعار المتجر" : "Shop logo")</h2>
        <p class="small text-secondary">@(ar ? "JPEG أو PNG بحد أقصى 5 ميغابايت. احفظ بيانات المتجر أولاً." : "JPEG or PNG; maximum 5 MB. Save business details first.")</p>
        <form asp-controller="ShopSettings" asp-action="UploadLogo" method="post"
              enctype="multipart/form-data" asp-antiforgery="true" class="d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1">
                <label for="shopLogo" class="form-label">@(ar ? "صورة الشعار" : "Logo image")</label>
                <input id="shopLogo" type="file" name="logo" class="form-control" accept="image/jpeg,image/png" required />
            </div>
            <button type="submit" class="btn btn-outline-primary">@(ar ? "تحديث الشعار" : "Upload logo")</button>
        </form>
    </div>
</div>
