@model IbdaaAtelier.Web.Models.Reports.SalesReportPage
@using System.Globalization
@{
    ViewData["Title"] = "Sales & collection reports";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA ATELIER · REPORTS</span>
        <h1 class="section-title mt-2 mb-1">@(ar ? "المبيعات والتحصيل" : "Sales & collection")</h1>
        <p class="text-secondary mb-0">@(ar ? "تقارير مبنية على الطلبات والمدفوعات الفعلية." : "Read-only figures from saved orders, receipts and refunds.")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-controller="Reports" asp-action="ExportSales"
           asp-route-period="@Model.Period" asp-route-from="@Model.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
           asp-route-to="@Model.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
            @(ar ? "تصدير المبيعات CSV" : "Export sales CSV")
        </a>
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">@(ar ? "لوحة التحكم" : "Dashboard")</a>
    </div>
</section>
<form asp-action="Index" method="get" class="card filter-card mb-4">
    <div class="card-body p-3 d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label" for="reportPeriod">@(ar ? "الفترة" : "Period")</label>
            <select class="form-select" id="reportPeriod" name="period">
                <option value="today" selected="@(Model.Period == "today")">@(ar ? "اليوم" : "Today")</option>
                <option value="yesterday" selected="@(Model.Period == "yesterday")">@(ar ? "أمس" : "Yesterday")</option>
                <option value="week" selected="@(Model.Period == "week")">@(ar ? "هذا الأسبوع" : "This week")</option>
                <option value="month" selected="@(Model.Period == "month")">@(ar ? "هذا الشهر" : "This month")</option>
                <option value="custom" selected="@(Model.Period == "custom")">@(ar ? "مخصص" : "Custom")</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="reportFrom">@(ar ? "من" : "From")</label>
            <input class="form-control" id="reportFrom" name="from" type="date"
                   value="@Model.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </div>
        <div>
            <label class="form-label" for="reportTo">@(ar ? "إلى" : "To")</label>
            <input class="form-control" id="reportTo" name="to" type="date"
                   value="@Model.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </div>
        <button class="btn btn-primary" type="submit">@(ar ? "تطبيق" : "Apply")</button>
    </div>
</form>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(ar ? "المبيعات" : "Sales")</small>
        <div class="h4 mb-0 mt-2">@Model.Sales.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(ar ? "المقبوض" : "Received")</small>
        <div class="h4 mb-0 mt-2">@Model.Collected.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(ar ? "المسترد" : "Refunded")</small>
        <div class="h4 mb-0 mt-2">@Model.Refunded.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
    <div class="col-6 col-xl-3"><div class="card feature-card h-100"><div class="card-body p-3">
        <small class="text-secondary">@(ar ? "المتبقي لجميع الطلبات النشطة" : "Outstanding (all active orders)")</small>
        <div class="h4 mb-0 mt-2">@Model.Outstanding.ToString("0.000", CultureInfo.InvariantCulture) KWD</div>
    </div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-5">
        <section class="card filter-card h-100">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5">@(ar ? "التحصيل حسب طريقة الدفع" : "Collection by method")</h2>
                <p class="small text-secondary">@(ar ? "صافي التحصيل = المقبوض - المسترد" : "Net = received minus refunds.")</p>
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle">
                        <thead><tr>
                            <th scope="col">@(ar ? "الطريقة" : "Method")</th>
                            <th scope="col" class="text-end">@(ar ? "المقبوض" : "Received")</th>
                            <th scope="col" class="text-end">@(ar ? "الصافي" : "Net")</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var method in Model.Methods)
                        {
                            <tr><td>@(method.Method == "Card" ? "WAMD" : method.Method)</td>
                                <td class="text-end">@method.Received.ToString("0.000", CultureInfo.InvariantCulture)</td>
                                <td class="text-end">@method.Net.ToString("0.000", CultureInfo.InvariantCulture)</td></tr>
                        }
                        @if (Model.Methods.Count == 0)
                        {
                            <tr><td colspan="3" class="py-4 text-secondary text-center">@(ar ? "لا توجد معاملات." : "No transactions in this period.")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="card filter-card h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between gap-3 flex-wrap">
                    <h2 class="h5">@(ar ? "قيمة المنتجات والخدمات قبل خصم الطلب" : "Product & service totals before order discounts")</h2>
                    <span class="text-secondary small">@(ar ? "أعلى ٢٠ نتيجة" : "Top 20 items")</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle">
                        <thead><tr>
                            <th scope="col">@(ar ? "العنصر" : "Item")</th>
                            <th scope="col">@(ar ? "العدد" : "Qty")</th>
                            <th scope="col" class="text-end">KWD</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>@(ar ? item.NameAr : item.Name)</strong>
                                    <small class="d-block text-secondary">@item.Type</small></td>
                                <td>@item.Quantity</td>
                                <td class="text-end">@item.Total.ToString("0.000", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                        @if (Model.Items.Count == 0)
                        {
                            <tr><td colspan="3" class="py-4 text-secondary text-center">@(ar ? "لا توجد مبيعات." : "No item sales in this period.")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="small text-secondary mt-3">
    @(ar ? "عدد الطلبات في الفترة" : "Orders in period"): @Model.Orders.
    @(ar ? "التقارير التفصيلية والتصدير ما زالا قيد التطوير." : "Additional detailed reports and PDF/Excel export remain pending.")
</div>

@section Scripts
{
    <script>
        const reportPeriod = document.getElementById("reportPeriod");
        for (const id of ["reportFrom", "reportTo"])
            document.getElementById(id).addEventListener("change", () => reportPeriod.value = "custom");
    </script>
}
