@model ProductListPage
@using System.Globalization
@{
    ViewData["Title"] = "Products";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA · ADMIN</span>
        <h1 class="section-title mt-2">@(ar ? "المنتجات" : "Products")</h1>
        <p class="text-secondary mb-0">@(ar ? "إدارة المنتجات والأسعار." : "Manage bilingual products and pricing.")</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@(ar ? "منتج جديد" : "Add product")</a>
</section>
@if (TempData["Message"] is string notice)
{
    <div class="alert alert-success" role="status">@notice</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<form method="get" class="d-flex gap-2 mb-4" role="search">
    <input type="search" name="search" class="form-control" maxlength="100" value="@Model.Search" placeholder="@(ar ? "اسم المنتج أو الرمز" : "Name or product code")" aria-label="@(ar ? "بحث" : "Search products")" />
    <button class="btn btn-primary" type="submit">@(ar ? "بحث" : "Search")</button>
</form>
<div class="card filter-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr>
                <th scope="col">SKU</th><th scope="col">@(ar ? "المنتج" : "Product")</th>
                <th scope="col">@(ar ? "الفئة" : "Category")</th><th scope="col">KWD</th>
                <th scope="col">@(ar ? "الحالة" : "Status")</th><th scope="col" class="text-end">@(ar ? "إجراءات" : "Actions")</th>
            </tr></thead>
            <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td class="small text-secondary">@product.ProductCode</td>
                    <td><strong>@product.Name</strong><small class="d-block text-secondary" lang="ar">@product.NameAr</small></td>
                    <td>@product.CategoryName</td>
                    <td class="text-nowrap">
                        <strong>@((product.DiscountPrice ?? product.RegularPrice).ToString("0.000", CultureInfo.InvariantCulture))</strong>
                        @if (product.DiscountPrice.HasValue)
                        {
                            <s class="small text-secondary d-block">@product.RegularPrice.ToString("0.000", CultureInfo.InvariantCulture)</s>
                        }
                    </td>
                    <td><span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-primary">@(ar ? "تعديل" : "Edit")</a>
                            <a asp-controller="ProductSetup" asp-action="Index" asp-route-productId="@product.ProductId" class="btn btn-sm btn-outline-primary">@(ar ? "المقاسات" : "Sizes")</a>
                            <a asp-controller="ProductImages" asp-action="Index" asp-route-productId="@product.ProductId" class="btn btn-sm btn-outline-primary">@(ar ? "الصور" : "Photos")</a>
                            <form asp-action="Toggle" asp-route-id="@product.ProductId" method="post" asp-antiforgery="true">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@(product.IsActive ? (ar ? "تعطيل" : "Deactivate") : (ar ? "تفعيل" : "Activate"))</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Products.Count == 0)
            {
                <tr><td colspan="6" class="py-5 text-center text-secondary">@(ar ? "لا توجد منتجات." : "No products found.")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pages" class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-secondary">@(ar ? "صفحة" : "Page") @Model.Page / @Model.TotalPages</span>
        <div class="d-flex gap-2">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-primary btn-sm" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">@(ar ? "السابق" : "Previous")</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-primary btn-sm" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">@(ar ? "التالي" : "Next")</a>
            }
        </div>
    </nav>
}
