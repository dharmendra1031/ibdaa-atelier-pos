@model IbdaaAtelier.Web.Models.Masters.ServiceCategoryForm
@using System.Globalization
@{
    ViewData["Title"] = "Service category";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="mb-4">
    <span class="eyebrow">IBDAA ATELIER · ALTERATIONS</span>
    <h1 class="section-title mt-2">@(Model.ServiceCategoryId == 0 ? (ar ? "فئة جديدة" : "Add category") : (ar ? "تعديل الفئة" : "Edit category"))</h1>
</section>
<div class="card filter-card"><div class="card-body p-4">
    <form method="post" asp-action="SaveCategory" asp-antiforgery="true">
        <input asp-for="ServiceCategoryId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">English name *</label>
                <input asp-for="Name" class="form-control" maxlength="100" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NameAr" class="form-label">الاسم بالعربية *</label>
                <input asp-for="NameAr" class="form-control" lang="ar" dir="rtl" maxlength="100" required />
                <span asp-validation-for="NameAr" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(ar ? "حفظ الفئة" : "Save category")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@(ar ? "إلغاء" : "Cancel")</a>
        </div>
    </form>
</div></div>
