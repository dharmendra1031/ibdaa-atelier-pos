@model IbdaaAtelier.Web.Models.Masters.ServiceListPage
@using System.Globalization
@{
    ViewData["Title"] = "Alteration services";
    var ar = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<section class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <span class="eyebrow">IBDAA ATELIER · SERVICES</span>
        <h1 class="section-title mt-2">@(ar ? "خدمات التعديل" : "Alteration services")</h1>
        <p class="text-secondary mb-0">@(ar ? "إدارة خدمات الخياطة مستقلة عن المنتجات." : "Tailoring services are managed separately from products.")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="CreateCategory" class="btn btn-outline-primary">@(ar ? "فئة خدمة جديدة" : "Add category")</a>
        <a asp-action="Create" class="btn btn-primary">@(ar ? "خدمة جديدة" : "Add service")</a>
    </div>
</section>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="row g-4">
    <div class="col-lg-4">
        <section class="card filter-card h-100">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-3">@(ar ? "فئات الخدمات" : "Service categories")</h2>
                @foreach (var category in Model.Categories)
                {
                    <div class="border-top py-3">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <strong>@(ar ? category.NameAr : category.Name)</strong>
                                <small class="d-block text-secondary">@(category.IsActive ? (ar ? "نشطة" : "Active") : (ar ? "غير نشطة" : "Inactive"))</small>
                            </div>
                            <a asp-action="EditCategory" asp-route-id="@category.ServiceCategoryId" class="btn btn-outline-primary btn-sm">@(ar ? "تعديل" : "Edit")</a>
                        </div>
                        <form method="post" asp-action="ToggleCategory" asp-route-id="@category.ServiceCategoryId" asp-antiforgery="true" class="mt-2">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@(category.IsActive ? (ar ? "تعطيل" : "Deactivate") : (ar ? "تفعيل" : "Activate"))</button>
                        </form>
                    </div>
                }
                @if (Model.Categories.Count == 0)
                {
                    <p class="text-secondary">@(ar ? "لا توجد فئات." : "No service categories yet.")</p>
                }
            </div>
        </section>
    </div>
    <div class="col-lg-8">
        <form method="get" asp-action="Index" class="d-flex gap-2 mb-3" role="search">
            <input class="form-control" name="search" type="search" value="@Model.Search" maxlength="100" placeholder="@(ar ? "ابحث عن خدمة" : "Search services")" aria-label="@(ar ? "بحث" : "Search services")" />
            <button type="submit" class="btn btn-primary">@(ar ? "بحث" : "Search")</button>
        </form>
        <div class="card filter-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr>
                        <th scope="col">@(ar ? "الخدمة" : "Service")</th>
                        <th scope="col">KWD</th>
                        <th scope="col">@(ar ? "الحالة" : "Status")</th>
                        <th scope="col" class="text-end">@(ar ? "إجراءات" : "Actions")</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var service in Model.Services)
                    {
                        <tr>
                            <td>
                                <strong>@(ar ? service.NameAr : service.Name)</strong>
                                <small class="d-block text-secondary" lang="@(ar ? "en" : "ar")">@((ar ? service.Name : service.NameAr))</small>
                            </td>
                            <td>@service.Price.ToString("0.000", CultureInfo.InvariantCulture)</td>
                            <td><span class="badge @(service.IsActive ? "text-bg-success" : "text-bg-secondary")">@(service.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap gap-2">
                                    <a asp-action="Edit" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-primary">@(ar ? "تعديل" : "Edit")</a>
                                    <form method="post" asp-action="Toggle" asp-route-id="@service.ServiceId" asp-antiforgery="true">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">@(service.IsActive ? (ar ? "تعطيل" : "Deactivate") : (ar ? "تفعيل" : "Activate"))</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Services.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-5">@(ar ? "لا توجد خدمات." : "No services found.")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3 d-flex align-items-center justify-content-between" aria-label="Service pages">
                <span class="small text-secondary">@Model.Page / @Model.TotalPages</span>
                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">@(ar ? "السابق" : "Previous")</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">@(ar ? "التالي" : "Next")</a>
                    }
                </div>
            </nav>
        }
    </div>
</div>
